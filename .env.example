# =============================================================================
# 1) Copy this file to ".env" in this folder (same level as package.json)
# 2) Fill every value. Full steps: SETUP_OAUTH.md
# =============================================================================

# --- PostgreSQL (Neon, Supabase, Railway, etc.) ---------------------------
# After setting, run:  npx prisma db push
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# --- NextAuth --------------------------------------------------------------
# Random secret, e.g. PowerShell: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256})-as[byte[]])
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# MUST match the URL you open in the browser (host + port, no trailing slash).
# If "next dev" uses port 3004, use http://localhost:3004 — not 3000.
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth (console.cloud.google.com → APIs & Services → Credentials) ---
# Web client → Authorized JavaScript origins:  http://localhost:PORT
# Web client → Authorized redirect URIs:       http://localhost:PORT/api/auth/callback/google
# Use the SAME PORT in NEXTAUTH_URL, Google origins, and redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
